{
  "rules": {
    "sessions": {
      "main": {
        "teams": {
          ".read": "auth != null",
          "$team": {
            ".write": "auth != null"
          }
        },
        "rosters": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "sleeperMapping": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "rfa": {
          "activePlayerId": { ".read": "auth != null", ".write": "auth != null" },
          "meta": {
            ".read": "auth != null",
            "$pid": { ".write": "auth != null" }
          },
          "status": {
            ".read": "auth != null",
            "$pid": {
              "$round": {
                "$team": {
                  ".write": "auth != null && auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val()"
                }
              }
            }
          },
          "private": {
            "$pid": {
              "$round": {
                "$team": {
                  ".read": "auth != null && (root.child('sessions/main/rfa/meta').child($pid).child('revealed').child($round).val() === true || auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val())",
                  ".write": "auth != null && auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val()"
                }
              }
            }
          }
        },
        "fa": {
          "activePlayerId": { ".read": "auth != null", ".write": "auth != null" },
          "customPlayers": { ".read": "auth != null", ".write": "auth != null" },
          "meta": {
            ".read": "auth != null",
            "$pid": { ".write": "auth != null" }
          },
          "status": {
            ".read": "auth != null",
            "$pid": {
              "$team": {
                ".write": "auth != null && auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val()"
              }
            }
          },
          "private": {
            "$pid": {
              "$team": {
                ".read": "auth != null && (root.child('sessions/main/fa/meta').child($pid).child('revealed').val() === true || auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val())",
                ".write": "auth != null && auth.uid === root.child('sessions/main/teams').child($team).child('claimedBy').val()"
              }
            }
          }
        }
      }
    }
  }
}
